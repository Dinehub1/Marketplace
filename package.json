{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hermes/web",
    "build": "npm run build -w @hermes/web",
    "start": "npm run start -w @hermes/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tokens": "node packages/tokens/scripts/extract.mjs",
    "mobile": "npm run start -w @hermes/mobile",
    "mobile:ios": "npm run ios -w @hermes/mobile",
    "mobile:android": "npm run android -w @hermes/mobile",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "expo-router": "~6.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
