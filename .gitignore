# ── dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── build output ──────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo

# ── expo / native ─────────────────────────────────────────────────────────
.expo/
# ios/ and android/ are generated by `expo prebuild` from app.json. They are
# gitignored on purpose: checking them in means every native config change has
# to be made twice — once in app.json and once by hand in the generated project
# — and the two drift. Add a config plugin instead. If you ever need to hand-edit
# native code, remove these two lines in the same commit and say why.
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── env ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── editor / os ───────────────────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# ── logs ──────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pm2/

# ── deploy ────────────────────────────────────────────────────────────────
.vercel

# ── large local data dumps (not source) ───────────────────────────────────
*.csv
GMaps Data/
sarkarmart-summary.txt

# Build output and scrape duplicates - never source
.next/
.next.bak/
combined_indore_master*.csv
apps/web/scripts/dev-tools/images_manifest.json
*.log

# ── local build/run artefacts ─────────────────────────────────────────────
__pycache__/
*.pyc
# safety copies taken before a risky edit; ad-hoc, never source
*.bak-*
*.bak
