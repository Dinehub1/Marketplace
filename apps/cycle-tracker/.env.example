# ─── AI Configuration ──────────────────────────────────────────────────────────
# OpenRouter API (https://openrouter.ai)
EXPO_PUBLIC_AI_API_KEY=your_openrouter_api_key_here
EXPO_PUBLIC_AI_MODEL=openrouter/free

EXPO_PUBLIC_AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# ─── Subscriptions (RevenueCat) ────────────────────────────────────────────────
# app.revenuecat.com → Project Settings → API Keys (public SDK keys, one per store)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# ─── Paywall legal links (required by App Store and Play review) ───────────────
# A privacy policy page you host. The paywall hides the link while this is empty.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# Optional custom terms; defaults to Apple's standard EULA.
EXPO_PUBLIC_TERMS_URL=
