{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `@hermes/expo-ui` (like `@hermes/core`) ships raw TypeScript and names its own
    // relative imports with an extension, because the packages are consumed as source by
    // Metro rather than built. `expo/tsconfig.base` does not set this flag, so an app
    // that imports a `@hermes/*` package has to add it.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
