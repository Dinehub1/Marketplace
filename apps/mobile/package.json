{
  "name": "@hermes/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "check:targets": "node ../../scripts/check-targets.mjs",
    "check:fleet": "node ../../scripts/check-fleet.mjs",
    "_comment_release": "The one gate a store build must pass. check-targets refuses two listings too alike to survive review (Apple 4.3 / Play spam); check-fleet --require-ready additionally refuses any listing whose first screen is not built, because such an app opens on nothing and cannot be submitted. Both are cheap and run before EAS is invoked, so a build that would be rejected fails here instead.",
    "check:release": "node ../../scripts/check-targets.mjs && node ../../scripts/check-fleet.mjs --require-ready",
    "icons": "node ../../scripts/make-app-icons.mjs",
    "eas:profiles": "node ../../scripts/make-eas-profiles.mjs",
    "_comment_target": "One codebase, twenty store apps. APP_TARGET picks which: `APP_TARGET=breathe npx expo start`, or for a store build `eas build --profile breathe`. Default is the marketplace. lib/target.ts reads it back at runtime.",
    "start:target": "expo start",
    "_comment_gate": "npm runs pre<name> before <name>. Every store build runs the full release gate, so a build that would be rejected for being too close to a sibling — or that opens on a screen nobody built — fails here instead of in review.",
    "prebuild:ios": "npm run check:release",
    "prebuild:android": "npm run check:release",
    "prebuild:preview": "npm run check:release",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "shots": "node ../../scripts/app-shots.mjs",
    "shots:fast": "node ../../scripts/app-shots.mjs --no-export"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@hermes/core": "*",
    "@hermes/tokens": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^57.0.22",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "^57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
