{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    /* This config extends Expo's base rather than the repo's tsconfig.base.json, so it
     * does not inherit the repo-wide flag. @hermes/core ships raw TypeScript whose
     * relative imports name their file (`./brand-scope.ts`) so plain `node --test` can
     * type-strip them; tsc needs this to accept those specifiers. */
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": [
        "./*"
      ],
      "@hermes/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@hermes/core": [
        "../../packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
