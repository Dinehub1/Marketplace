{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "env": {},
      "cache": {
        "disabled": false
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "block-clear": {
      "extends": "production",
      "channel": "block-clear",
      "env": {
        "APP_TARGET": "block-clear"
      }
    },
    "merge-tiles": {
      "extends": "production",
      "channel": "merge-tiles",
      "env": {
        "APP_TARGET": "merge-tiles"
      }
    },
    "passport-photo": {
      "extends": "production",
      "channel": "passport-photo",
      "env": {
        "APP_TARGET": "passport-photo"
      }
    },
    "pdf-tools": {
      "extends": "production",
      "channel": "pdf-tools",
      "env": {
        "APP_TARGET": "pdf-tools"
      }
    },
    "resume-builder": {
      "extends": "production",
      "channel": "resume-builder",
      "env": {
        "APP_TARGET": "resume-builder"
      }
    },
    "room-redesign": {
      "extends": "production",
      "channel": "room-redesign",
      "env": {
        "APP_TARGET": "room-redesign"
      }
    },
    "sarkarcars": {
      "extends": "production",
      "channel": "sarkarcars",
      "env": {
        "APP_TARGET": "sarkarcars"
      }
    },
    "sarkarhealth": {
      "extends": "production",
      "channel": "sarkarhealth",
      "env": {
        "APP_TARGET": "sarkarhealth"
      }
    },
    "shop-toolkit": {
      "extends": "production",
      "channel": "shop-toolkit",
      "env": {
        "APP_TARGET": "shop-toolkit"
      }
    },
    "subtitles-voice": {
      "extends": "production",
      "channel": "subtitles-voice",
      "env": {
        "APP_TARGET": "subtitles-voice"
      }
    },
    "tap-sprint": {
      "extends": "production",
      "channel": "tap-sprint",
      "env": {
        "APP_TARGET": "tap-sprint"
      }
    },
    "toolbox": {
      "extends": "production",
      "channel": "toolbox",
      "env": {
        "APP_TARGET": "toolbox"
      }
    },
    "wellness": {
      "extends": "production",
      "channel": "wellness",
      "env": {
        "APP_TARGET": "wellness"
      }
    },
    "word-duel": {
      "extends": "production",
      "channel": "word-duel",
      "env": {
        "APP_TARGET": "word-duel"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
