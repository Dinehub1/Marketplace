{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    // `@hermes/core` ships raw TypeScript and names its own relative imports with a
    // `.ts` extension, because its test suite runs under plain `node --test`, which
    // strips types instead of resolving extensions. `tsconfig.base.json` sets this for
    // the workspaces that already import the package; `expo/tsconfig.base` does not, so
    // an app that starts importing `@hermes/core` has to set it too.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
