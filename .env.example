# Copy to apps/web/.env — Next.js loads .env from the app directory, not the
# repo root, so a file here is never read.
#
# The mobile app does NOT read this file. React Native has no dotenv at
# runtime: its configuration lives in apps/mobile/app.json → expo.extra, or in
# an EAS build profile. See apps/mobile/README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Phase 0 payments (Razorpay) ──
# Get these from dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys in test mode; switch to rzp_live_* for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Shown when you register the webhook endpoint (Dashboard → Webhooks).
# The route that consumes it: apps/web/app/api/payments/webhook/route.ts
RAZORPAY_WEBHOOK_SECRET=

# ── International Gateway (PayPal) ──
# Get these from developer.paypal.com → Apps & Credentials.
# Set PAYPAL_ENV to "sandbox" for testing, "live" for production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# ── In-App Purchases & Subscriptions (RevenueCat: Apple StoreKit + Google Play) ──
# Used in Expo apps (e.g. cycle-tracker, mobile) for compliant digital subscriptions.
# Get these from app.revenuecat.com → Project Settings → API Keys.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# Supabase Edge Function webhook auth secret (RevenueCat Dashboard → Webhooks → Authorization header)
REVENUECAT_WEBHOOK_AUTH=


# Optional: approved WhatsApp template id for the boost-confirmation alert.
NEXTEL_BOOST_TEMPLATE=


# AdMob publisher id (public; appears in /app-ads.txt). Format: pub-XXXXXXXXXXXXXXXX
ADMOB_PUBLISHER_ID=

# Product worker (services/tools/worker.py). On the VM the web app calls it on loopback
# and needs none of these. From Vercel it goes through the tunnel:
#   PRODUCT_WORKER_URL=https://worker.dropby.co.in
# WORKER_SHARED_SECRET must match on both sides; worker.py also reads it from apps/web/.env.
# Without it, every request that arrives through the tunnel gets 403.
PRODUCT_WORKER_URL=
WORKER_SHARED_SECRET=
# Optional Cloudflare Access service token in front of worker.dropby.co.in
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ── Unified AI Engine (OpenRouter, Jev Decision Model, DeepSeek) ───────────────
OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jev System One Decision Engine (TypeSafe on OpenRouter)
EXPO_PUBLIC_JEV_MODEL=typesafe/jev-1.13
EXPO_PUBLIC_JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
EXPO_PUBLIC_JEV_SYSTEMONE_URL=https://openrouter.ai/api/v1/systemone

# DeepSeek API (Direct reasoning & chat completions)
DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat

# Default LLM Fallbacks (Never bundle private production keys in client builds)
OPENROUTER_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
EXPO_PUBLIC_AI_MODEL=deepseek/deepseek-chat

# ── App-Specific Supabase Endpoints ───────────────────────────────────────────
EXPO_PUBLIC_GATTED_SUPABASE_URL=
EXPO_PUBLIC_GATTED_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DINING_SUPABASE_URL=
EXPO_PUBLIC_DINING_SUPABASE_ANON_KEY=

