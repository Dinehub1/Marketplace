# Copy to apps/web/.env — Next.js loads .env from the app directory, not the
# repo root, so a file here is never read.
#
# The mobile app does NOT read this file. React Native has no dotenv at
# runtime: its configuration lives in apps/mobile/app.json → expo.extra, or in
# an EAS build profile. See apps/mobile/README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Phase 0 payments (Razorpay) ──
# Get these from dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys in test mode; switch to rzp_live_* for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Shown when you register the webhook endpoint (Dashboard → Webhooks).
# The route that consumes it: apps/web/app/api/payments/webhook/route.ts
RAZORPAY_WEBHOOK_SECRET=

# Optional: approved WhatsApp template id for the boost-confirmation alert.
NEXTEL_BOOST_TEMPLATE=

